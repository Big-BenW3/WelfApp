# Neon or any standard PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host.neon.tech/wella?sslmode=require

# A long random string used to sign the Wella session cookie.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional public origin used for canonical metadata in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
